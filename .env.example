# Server-only secrets. Never expose these with a NEXT_PUBLIC_ prefix.
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-5.6-luna
OPENAI_SEARCH_MODEL=gpt-5.6-luna
OPENAI_IMAGE_MODEL=gpt-image-2.5-flare
OPENAI_REALTIME_MODEL=gpt-realtime-2.1-mini
OPENAI_REALTIME_TRANSCRIPTION_MODEL=gpt-live-transcribe
AI_LIVE_CLASSIFIER_ENABLED=true
AI_ASSET_SEARCH_ENABLED=true
AI_IMAGE_GENERATION_ENABLED=true
# generation_first avoids a web-search charge when image generation succeeds.
# Use parallel to race both providers, web_first to prefer existing images, or off to disable search.
AI_ASSET_SEARCH_MODE=generation_first
AI_MAX_VISUAL_ASSETS=8
AI_MAX_EXPLICIT_VISUAL_CONCEPTS=6

# Supabase server-side asset cache.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ASSET_BUCKET=bridgeboard-ai-assets
SUPABASE_SIGNED_URL_TTL_SECONDS=3600

# Restrict automatic web-image fetching to known hosts. Comma-separated.
AI_ALLOWED_IMAGE_DOMAINS=images.unsplash.com,images.pexels.com,upload.wikimedia.org,commons.wikimedia.org,www.pexels.com,unsplash.com
AI_ASSET_MAX_BYTES=5242880
