# Server-only. Never prefix these values with NEXT_PUBLIC_.
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-5.6-luna
OPENAI_SEARCH_MODEL=gpt-5.6-luna
OPENAI_IMAGE_MODEL=gpt-image-2.5-flare
OPENAI_REALTIME_MODEL=gpt-realtime-2.1-mini
OPENAI_REALTIME_TRANSCRIPTION_MODEL=gpt-live-transcribe

# Server-only ElevenLabs text-to-speech settings.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_flash_v2_5

ASSET_STREAM_SECRET=
AI_ASSET_SEARCH_ENABLED=true
AI_IMAGE_GENERATION_ENABLED=true
AI_MAX_VISUAL_ASSETS=6
AI_ALLOWED_IMAGE_DOMAINS=images.unsplash.com,images.pexels.com,upload.wikimedia.org,commons.wikimedia.org
AI_ASSET_MAX_BYTES=5242880
AI_ASSET_OUTPUT_MAX_BYTES=786432

# Optional server-side shared asset cache.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Browser-safe values from Supabase Project Settings > API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_ASSET_BUCKET=bridgeboard-ai-assets
SUPABASE_SIGNED_URL_TTL_SECONDS=3600

# Supabase email/password account creation and sign-in.
#
# This is the publishable key (sb_publishable_...), which is safe to expose by
# design — but it is intentionally NOT prefixed NEXT_PUBLIC_. BridgeBoard runs
# every auth call server-side and keeps the session in httpOnly cookies, so no
# Supabase client is ever constructed in the browser.
