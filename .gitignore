# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
# Unanchored on purpose: "/node_modules" matched the root only, so a
# node_modules inside any subdirectory slipped through and 428 vendored
# files were committed once already.
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# Supabase CLI runtime state
/supabase/.temp/

# typescript
*.tsbuildinfo
next-env.d.ts

# The Vite app the merged Next.js app replaced. Its source lives on the
# `frontend` branch; only build output ever reached main.
/frontend/
